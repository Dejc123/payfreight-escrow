import { createClient } from '@supabase/supabase-js';
import { Resend } from 'resend';

const SUPABASE_URL = process.env.SUPABASE_URL || 'https://wqjqjfxyucufuyioxphm.supabase.co';
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY || process.env.SUPABASE_ANON_KEY;
const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

const resend = new Resend(process.env.RESEND_API_KEY);

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { identifier } = req.body; // E-mail ali Uporabniško ime

    if (!identifier) {
      return res.status(400).json({ error: 'Email or Username is required.' });
    }

    // 1. Iskanje v bazi (preverimo med podjetji in med člani ekipe)
    let userEmail = null;
    let foundUsername = null;
    let userPassword = null;

    // Najprej preverimo med člani ekipe (team_members)
    const { data: memberData } = await supabase
      .from('team_members')
      .select('email, username, password')
      .or(`email.eq.${identifier},username.eq.${identifier}`)
      .limit(1)
      .maybeSingle();

    if (memberData) {
      userEmail = memberData.email;
      foundUsername = memberData.username;
      userPassword = memberData.password;
    } else {
      // Če ni član, preverimo glavno tabelo podjetij/registracij (companies)
      const { data: companyData } = await supabase
        .from('companies')
        .select('contact_email, company_name')
        .or(`contact_email.eq.${identifier},company_name.eq.${identifier}`)
        .limit(1)
        .maybeSingle();

      if (companyData) {
        userEmail = companyData.contact_email;
        foundUsername = companyData.company_name;
        userPassword = "[Protected / Use Reset Link]";
      }
    }

    if (!userEmail) {
      return res.status(404).json({ error: 'No account found with this Email or Username.' });
    }

    // 2. Pošiljanje e-pošte z opomnikom za dostop
    await resend.emails.send({
      from: 'CargoNet Support <onboarding@resend.dev>',
      to: userEmail,
      subject: 'CargoNet Account Recovery & Password Reminder',
      html: `
        <div style="font-family: Arial, sans-serif; padding: 20px; color: #1e293b; max-width: 500px; border: 1px solid #e2e8f0; border-radius: 12px;">
          <h2 style="color: #0284c7; margin-bottom: 8px;">CargoNet Account Recovery</h2>
          <p style="font-size: 14px; color: #64748b;">We received a password recovery request for your account.</p>
          
          <div style="background-color: #f8fafc; padding: 15px; border-radius: 8px; margin: 20px 0; border-left: 4px solid #0284c7;">
            <p style="margin: 0; font-size: 13px;"><strong>Username / Account:</strong> ${foundUsername}</p>
            <p style="margin: 8px 0 0 0; font-size: 13px;"><strong>Password / Key:</strong> ${userPassword}</p>
          </div>

          <p style="font-size: 12px; color: #94a3b8;">If you did not request this email, you can safely ignore it.</p>
        </div>
      `
    });

    return res.status(200).json({
      success: true,
      message: 'Password reminder sent to your registered email address.'
    });

  } catch (error) {
    console.error("Forgot password error:", error);
    return res.status(500).json({ error: error.message });
  }
}

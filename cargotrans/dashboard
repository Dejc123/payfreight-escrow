<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CargoNet | European Digital Freight Exchange</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              500: '#0284c7',
              600: '#0369a1',
              800: '#075985',
              900: '#0f172a',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-50 font-sans text-slate-800 antialiased min-h-screen flex flex-col">

  <!-- TOP NAVIGATION (Navbar) -->
  <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Logo & Status -->
        <div class="flex items-center space-x-3">
          <div class="bg-blue-600 text-white p-2 rounded-lg font-black tracking-wider text-xl flex items-center space-x-1">
            <i data-lucide="truck" class="w-6 h-6"></i>
            <span>Cargo<span class="text-blue-400">Net</span></span>
          </div>
          <span class="bg-slate-800 text-slate-300 text-xs px-2.5 py-1 rounded-full border border-slate-700 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            EU Exchange
          </span>
        </div>

        <!-- Navigation Menu -->
        <nav class="hidden md:flex items-center space-x-1">
          <a href="#" class="px-3 py-2 rounded-md text-sm font-medium bg-slate-800 text-white">Live Board</a>
          <a href="#" class="px-3 py-2 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800">My Listings</a>
          <a href="#" class="px-3 py-2 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800">Transport Orders (e-CMR)</a>
          <a href="#" class="px-3 py-2 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800">Company Directory</a>
        </nav>

        <!-- Right Side: Language & User Profile -->
        <div class="flex items-center space-x-4">
          <div class="flex items-center space-x-1 bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700 text-xs text-slate-300">
            <i data-lucide="globe" class="w-4 h-4"></i>
            <span class="font-semibold">EN</span>
            <i data-lucide="chevron-down" class="w-3 h-3 text-slate-400"></i>
          </div>

          <div class="flex items-center space-x-3 pl-2 border-l border-slate-800">
            <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm">
              DL
            </div>
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- WELCOME & PRIMARY ACTIONS -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
      <div class="max-w-3xl mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Next-Gen Freight & Transport Capacity Exchange
        </h1>
        <p class="text-slate-500 mt-1">
          Post shipments or instantly source available trucks across 7,000+ verified European logistics partners.
        </p>
      </div>

      <!-- Action Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Post Cargo -->
        <button class="flex flex-col justify-between p-5 bg-gradient-to-br from-blue-50 to-slate-50 hover:from-blue-100 hover:to-blue-50 border border-blue-200/80 rounded-xl transition-all duration-200 group text-left shadow-sm hover:shadow">
          <div>
            <div class="w-10 h-10 bg-blue-600 text-white rounded-lg flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <i data-lucide="package-plus" class="w-5 h-5"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-base">Post Freight</h3>
            <p class="text-xs text-slate-500 mt-1">Publish available load for carriers</p>
          </div>
          <div class="mt-4 flex items-center text-xs font-semibold text-blue-600 group-hover:translate-x-1 transition-transform">
            <span>New Listing</span>
            <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-1"></i>
          </div>
        </button>

        <!-- Post Truck -->
        <button class="flex flex-col justify-between p-5 bg-gradient-to-br from-emerald-50 to-slate-50 hover:from-emerald-100 hover:to-emerald-50 border border-emerald-200/80 rounded-xl transition-all duration-200 group text-left shadow-sm hover:shadow">
          <div>
            <div class="w-10 h-10 bg-emerald-600 text-white rounded-lg flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <i data-lucide="truck" class="w-5 h-5"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-base">Post Truck</h3>
            <p class="text-xs text-slate-500 mt-1">List available vehicle capacity</p>
          </div>
          <div class="mt-4 flex items-center text-xs font-semibold text-emerald-600 group-hover:translate-x-1 transition-transform">
            <span>Offer Capacity</span>
            <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-1"></i>
          </div>
        </button>

        <!-- Search Cargo -->
        <button class="flex flex-col justify-between p-5 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl transition-all duration-200 group text-left shadow-sm hover:shadow">
          <div>
            <div class="w-10 h-10 bg-slate-100 text-slate-700 rounded-lg flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <i data-lucide="search" class="w-5 h-5"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-base">Find Freight</h3>
            <p class="text-xs text-slate-500 mt-1">Search loads for your fleet</p>
          </div>
          <div class="mt-4 flex items-center text-xs font-semibold text-slate-600 group-hover:translate-x-1 transition-transform">
            <span>Open Search</span>
            <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-1"></i>
          </div>
        </button>

        <!-- Search Trucks -->
        <button class="flex flex-col justify-between p-5 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl transition-all duration-200 group text-left shadow-sm hover:shadow">
          <div>
            <div class="w-10 h-10 bg-slate-100 text-slate-700 rounded-lg flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <i data-lucide="users" class="w-5 h-5"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-base">Find Trucks</h3>
            <p class="text-xs text-slate-500 mt-1">Browse available carriers</p>
          </div>
          <div class="mt-4 flex items-center text-xs font-semibold text-slate-600 group-hover:translate-x-1 transition-transform">
            <span>Browse Carriers</span>
            <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-1"></i>
          </div>
        </button>

      </div>
    </div>

    <!-- QUICK SEARCH FILTER -->
    <div class="bg-slate-900 text-white rounded-xl p-4 sm:p-6 shadow-md">
      <div class="flex flex-col lg:flex-row items-center gap-4">
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full flex-1">
          <!-- Loading Origin -->
          <div class="relative">
            <label class="block text-xs text-slate-400 mb-1 font-medium">Origin (Loading)</label>
            <div class="flex items-center bg-slate-800 border border-slate-700 rounded-lg px-3 py-2">
              <i data-lucide="map-pin" class="w-4 h-4 text-slate-400 mr-2"></i>
              <input type="text" placeholder="Country, city or zip..." class="bg-transparent text-sm text-white focus:outline-none w-full placeholder-slate-500">
            </div>
          </div>

          <!-- Unloading Destination -->
          <div class="relative">
            <label class="block text-xs text-slate-400 mb-1 font-medium">Destination (Unloading)</label>
            <div class="flex items-center bg-slate-800 border border-slate-700 rounded-lg px-3 py-2">
              <i data-lucide="navigation" class="w-4 h-4 text-slate-400 mr-2"></i>
              <input type="text" placeholder="Country, city or zip..." class="bg-transparent text-sm text-white focus:outline-none w-full placeholder-slate-500">
            </div>
          </div>

          <!-- Vehicle Body Type -->
          <div>
            <label class="block text-xs text-slate-400 mb-1 font-medium">Vehicle Type</label>
            <div class="flex items-center bg-slate-800 border border-slate-700 rounded-lg px-3 py-2">
              <i data-lucide="truck" class="w-4 h-4 text-slate-400 mr-2"></i>
              <select class="bg-transparent text-sm text-white focus:outline-none w-full cursor-pointer">
                <option class="bg-slate-800">All Vehicle Types</option>
                <option class="bg-slate-800">Curtainsider / Tautliner</option>
                <option class="bg-slate-800">Reefer (Refrigerated)</option>
                <option class="bg-slate-800">Car Transporter</option>
                <option class="bg-slate-800">Van (up to 3.5t)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Filter Button -->
        <div class="w-full lg:w-auto self-end">
          <button class="w-full lg:w-auto bg-blue-600 hover:bg-blue-500 text-white px-6 py-2.5 rounded-lg font-medium text-sm transition-colors flex items-center justify-center space-x-2">
            <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
            <span>Filter Exchange</span>
          </button>
        </div>

      </div>
    </div>

    <!-- LIVE FREIGHT BOARD TABLE -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      
      <!-- Table Header -->
      <div class="p-5 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>Live Freight Exchange</span>
            <span class="bg-blue-100 text-blue-700 text-xs px-2 py-0.5 rounded-full font-semibold">1,248</span>
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">Updated 5 seconds ago</p>
        </div>

        <div class="flex items-center space-x-2">
          <button class="px-3 py-1.5 text-xs font-semibold bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200 transition">
            All Listings
          </button>
          <button class="px-3 py-1.5 text-xs font-semibold text-slate-500 hover:bg-slate-100 rounded-lg transition">
            Freight Only
          </button>
          <button class="px-3 py-1.5 text-xs font-semibold text-slate-500 hover:bg-slate-100 rounded-lg transition">
            Trucks Only
          </button>
        </div>
      </div>

      <!-- Table Content -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
              <th class="py-3.5 px-4">Type</th>
              <th class="py-3.5 px-4">Route (Origin → Destination)</th>
              <th class="py-3.5 px-4">Specification</th>
              <th class="py-3.5 px-4">Date & Time</th>
              <th class="py-3.5 px-4">Company / Rating</th>
              <th class="py-3.5 px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm">
            
            <!-- Row 1 -->
            <tr class="hover:bg-slate-50/80 transition-colors">
              <td class="py-4 px-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                  <i data-lucide="package" class="w-3.5 h-3.5 mr-1"></i> Freight
                </span>
              </td>
              <td class="py-4 px-4 whitespace-nowrap">
                <div class="flex items-center space-x-2 font-medium text-slate-900">
                  <span class="font-bold">SI-8000 Novo Mesto</span>
                  <i data-lucide="arrow-right" class="w-4 h-4 text-slate-400"></i>
                  <span class="font-bold">DE-80331 Munich</span>
                </div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-xs text-slate-600">
                <div class="font-semibold text-slate-800">Palletized Cargo (24t)</div>
                <div>Standard Tautliner · 13.6m</div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-xs text-slate-600">
                <div>Today, 14:00</div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-xs">
                <div class="font-semibold text-slate-900">Logistika Trans d.o.o.</div>
                <div class="flex items-center text-amber-500 mt-0.5">
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <span class="text-slate-400 ml-1 text-[10px]">(48)</span>
                </div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-right">
                <button class="bg-slate-900 hover:bg-slate-800 text-white text-xs px-3.5 py-1.5 rounded-lg font-medium transition">
                  View Contact
                </button>
              </td>
            </tr>

            <!-- Row 2 -->
            <tr class="hover:bg-slate-50/80 transition-colors">
              <td class="py-4 px-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                  <i data-lucide="truck" class="w-3.5 h-3.5 mr-1"></i> Free Truck
                </span>
              </td>
              <td class="py-4 px-4 whitespace-nowrap">
                <div class="flex items-center space-x-2 font-medium text-slate-900">
                  <span class="font-bold">IT-20100 Milan</span>
                  <i data-lucide="arrow-right" class="w-4 h-4 text-slate-400"></i>
                  <span class="font-bold">SI-1000 Ljubljana</span>
                </div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-xs text-slate-600">
                <div class="font-semibold text-slate-800">Reefer / Cold Chain</div>
                <div>Capacity: 18t · Temp (-18°C)</div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-xs text-slate-600">
                <div>Tomorrow, 08:00</div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-xs">
                <div class="font-semibold text-slate-900">EuroTransport Sped</div>
                <div class="flex items-center text-amber-500 mt-0.5">
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star-half" class="w-3 h-3 fill-current"></i>
                  <span class="text-slate-400 ml-1 text-[10px]">(112)</span>
                </div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-right">
                <button class="bg-slate-900 hover:bg-slate-800 text-white text-xs px-3.5 py-1.5 rounded-lg font-medium transition">
                  View Contact
                </button>
              </td>
            </tr>

            <!-- Row 3 -->
            <tr class="hover:bg-slate-50/80 transition-colors">
              <td class="py-4 px-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                  <i data-lucide="package" class="w-3.5 h-3.5 mr-1"></i> Freight
                </span>
              </td>
              <td class="py-4 px-4 whitespace-nowrap">
                <div class="flex items-center space-x-2 font-medium text-slate-900">
                  <span class="font-bold">AT-1010 Vienna</span>
                  <i data-lucide="arrow-right" class="w-4 h-4 text-slate-400"></i>
                  <span class="font-bold">HR-10000 Zagreb</span>
                </div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-xs text-slate-600">
                <div class="font-semibold text-slate-800">Automotive Parts</div>
                <div>Van / Express · up to 3.5t</div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-xs text-slate-600">
                <div>Oct 29, 10:00</div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-xs">
                <div class="font-semibold text-slate-900">AlpeAdria Cargo</div>
                <div class="flex items-center text-amber-500 mt-0.5">
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                  <span class="text-slate-400 ml-1 text-[10px]">(19)</span>
                </div>
              </td>
              <td class="py-4 px-4 whitespace-nowrap text-right">
                <button class="bg-slate-900 hover:bg-slate-800 text-white text-xs px-3.5 py-1.5 rounded-lg font-medium transition">
                  View Contact
                </button>
              </td>
            </tr>

          </tbody>
        </table>
      </div>

      <!-- Table Footer / Pagination -->
      <div class="p-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between text-xs text-slate-500">
        <span>Showing 1-3 of 1,248 listings</span>
        <div class="flex space-x-1">
          <button class="px-2.5 py-1 bg-white border border-slate-300 rounded font-medium text-slate-700">Previous</button>
          <button class="px-2.5 py-1 bg-blue-600 text-white rounded font-medium">1</button>
          <button class="px-2.5 py-1 bg-white border border-slate-300 rounded font-medium text-slate-700">2</button>
          <button class="px-2.5 py-1 bg-white border border-slate-300 rounded font-medium text-slate-700">Next</button>
        </div>
      </div>

    </div>

  </main>

  <!-- FOOTER -->
  <footer class="bg-white border-t border-slate-200 mt-auto py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        © 2026 CargoNet. All rights reserved.
      </div>
      <div class="flex items-center space-x-6">
        <a href="#" class="hover:text-slate-800 transition">Terms of Service</a>
        <a href="#" class="hover:text-slate-800 transition">Privacy Policy</a>
        <a href="#" class="hover:text-slate-800 transition">Customer Support</a>
        <a href="#" class="hover:text-slate-800 transition">LinkedIn</a>
      </div>
    </div>
  </footer>

  <!-- Lucide Icons Initialization -->
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
